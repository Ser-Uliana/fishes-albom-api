// use prisma-8

model FishType {
  id    Int    @id @default(autoincrement())
  name  String?
  fish  Fish[]
  color String? @default("gray")
}

model Fish {
  id          Int       @id @default(autoincrement())
  name        String?
  image       String?
  description String?
  isCaught     Boolean   @default(false)
  place        String?
  bait         String?
  date         DateTime
  comments     String?
  idType       Int
  weight       Float?

  fishType     FishType  @relation(fields: [idType], references: [id])
}

model User{
  id          Int     @id @default(autoincrement())
  email       String? 
  password    String? 
  role        String? @default('user')
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)
}